{
  "jhoc-gate": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "py -3 \"G:/JHOC/scripts/jhoc_pre_inject.py\"",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "py -3 \"G:/JHOC/scripts/jhoc_post_verify.py\"",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"G:/JHOC/scripts/jhoc_hook_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"G:/JHOC/scripts/jhoc_hook_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"G:/JHOC/scripts/jhoc_hook_gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"G:/JHOC/scripts/jhoc_hook_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "py -3 \"G:/JHOC/scripts/jhoc_stop_guard.py\"",
        "timeout": 10
      }
    ]
  }
}
